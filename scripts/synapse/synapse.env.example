# QIG synapse daemon config. Deploy to ~/.config/qig/synapse.env (chmod 600).
# The daemon sources this file. Contains a bearer token once provisioned — never
# commit a filled-in copy.

QIG_MEMORY_URL=https://quauntum.dev

# REQUIRED. A scoped qig-memory key (memory:read + memory:write for the heartbeat).
# `setup.sh` provisions this automatically via POST /api/keys/synapse; or paste one
# after the = with no quotes. Empty => the daemon exits 78 (config guard) and will
# not spin-restart.
QIG_API_KEY=

# Poll cadence in seconds.
QIG_POLL_SECONDS=45

# Inbox namespaces to sweep each cycle (space-separated). The daemon polls ALL of
# these — it is not qig-only. One API call per namespace per cycle. Trim to just
# the projects you run if you want fewer calls.
QIG_NAMESPACES="qig bsuite general"

# Envelope TYPES that trigger a desktop ping (space-separated, case-insensitive).
QIG_URGENT_TYPES="DIRECTIVE BLOCKER HANDOFF RULING-REQUEST"

# OPTIONAL allow-list of recipient handles (space-separated, case-insensitive).
# Empty = surface EVERY urgent lane's mail (each ping names the receiving lane +
# its liveness). Set it to narrow which lanes ping this desktop.
QIG_WATCH=""

# A lane whose presence record (qig_presence_<handle>) has not refreshed within
# this many minutes is shown as DARK in the alert.
QIG_PRESENCE_STALE_MIN=20

# 1 = enrich each ping with a one-line model brief; 0 = subject only.
QIG_SUMMARIZE=1
# Summariser backend: ollama (LOCAL, free, private — default), claude (CLI), none.
# The daemon sends think:false and a verbatim-echo prompt (protocol v1.4: the
# synapse ECHOES, it does not compose). A fast/small local model is ideal.
QIG_SUMMARIZE_BACKEND=ollama
QIG_OLLAMA_URL=http://localhost:11434
QIG_OLLAMA_MODEL=liquidai/lfm2.5-1.2b-instruct:latest
# keep_alive=0 unloads the model from RAM/VRAM immediately after each summary
# (near-zero idle footprint). A warm value (e.g. 5m) trades RAM for speed.
QIG_OLLAMA_KEEPALIVE=0

# --- Agent-to-agent DISPATCH (opt-in) --------------------------------------
# 1 = beyond pinging, WAKE the receiving lane as a headless `claude -p` agent so
# idle lanes coordinate without a human. 0 = route/ping only (default). See
# dispatch.sh. This spawns autonomous agents — keep the guardrails below sane.
QIG_DISPATCH=0
# Only lanes listed in this file are wakeable (per-lane cwd/model/max_turns).
QIG_LANES_FILE="$HOME/.config/qig/lanes.json"
# Hard caps so a reply chain can't run away or drain tokens:
QIG_DISPATCH_MAX_PER_HOUR=6   # global autonomous wakes / hour
QIG_DISPATCH_MAX_DEPTH=2      # reply chain dies once payload.wake_depth hits this
QIG_DISPATCH_MODEL=sonnet     # default worker model (per-lane override in lanes.json)
QIG_DISPATCH_MAX_TURNS=20     # per-wake turn ceiling
# SECURITY: the woken agent is confined by an explicit tool ALLOW-LIST, never a
# permission bypass — the inbox is untrusted input and its body may carry prompt
# injection. This list is the agent's ENTIRE tool surface (no Bash/Write/Edit/web),
# so injected content can at worst send bounded mesh messages. Widen with care.
QIG_DISPATCH_ALLOWED_TOOLS="mcp__qig-memory__inbox_read,mcp__qig-memory__inbox_send,mcp__qig-memory__inbox_ack,mcp__qig-memory__memory_get,mcp__qig-memory__memory_search,mcp__qig-memory__helper_ask"
# Extra worker CLI args. Leave EMPTY. NEVER put --permission-mode bypassPermissions
# (or --dangerously-skip-permissions) here — that re-opens the injection→RCE path.
QIG_DISPATCH_CLAUDE_ARGS=""
