[Unit]
Description=QIG synapse — always-on inbox watcher / pinger (daemon lane)
# Protocol of record lives at qig-memory key `qig_interagent_protocol`. systemd's
# Documentation= only accepts http(s)/file/man/info URIs, so `memory:` logged
# "Invalid URL, ignoring" every boot. Point at the API path that serves the key
# (auth-gated, but the correct location) so the pointer is valid and honest.
Documentation=https://quauntum.dev/api/memory/qig_interagent_protocol
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/share/qig-synapse/synapse.sh
Restart=always
RestartSec=15
# Config errors (missing QIG_API_KEY) exit 78; don't spin-restart on those.
RestartPreventExitStatus=78
# notify-send needs the desktop session bus; import the user env.
PassEnvironment=DBUS_SESSION_BUS_ADDRESS DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR

[Install]
WantedBy=default.target
